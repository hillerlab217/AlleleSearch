params {
    // Input directories (must be specified on command line)
    query_dir       = null
    genome_dir      = null
    code_dir        = "${projectDir}/code"

    // Output
    outdir          = "${projectDir}/results"

    // BLAST parameters
    blast_type         = 'blastn'
    make_blastdb       = false
    blast_batch_size   = 100

    // Shared BLAST tuning (blastn + tblastn)
    blast_word_size    = null   // -word_size
    blast_gapopen      = null   // -gapopen
    blast_gapextend    = null   // -gapextend

    // tblastn-specific tuning (ignored when blast_type=blastn)
    tblastn_matrix     = null   // -matrix (e.g. PAM30, BLOSUM45)
    tblastn_threshold  = null   // -threshold
    tblastn_comp_based = null   // -comp_based_stats (e.g. 0, 1, 2)
    tblastn_seg        = null   // -seg (e.g. no, yes)

    // Filtering cutoffs
    max_evalue         = 0.00001
    sequence_identity  = 80
    length_percentage  = 80

    // Sequence mode
    mode               = 'protein'  // 'protein' (default) or 'dna' — dna skips ORF finding and translation

    // ORF extension
    extension_codons   = 10
    start_codons       = "ATG,GTG,TTG"
    stop_codons        = "TAA,TGA,TAG"

    // Allele filtering
    species_threshold  = 1

    // Alignment figure options
    self_reference_figures = false

    // WebLogo parameters
    weblogo_format       = 'eps'
    weblogo_units        = 'probability'
    weblogo_color_scheme = 'chemistry'
    weblogo_size         = 'medium'
    weblogo_resolution   = 96

    // Neighbour extraction
    upstream           = 0      // bp upstream of gene to extract (0 = skip)
    downstream         = 0      // bp downstream of gene to extract (0 = skip)
    flank_only         = false  // exclude the gene from output (default: include_gene)
    neighbour_merge    = false  // merge upstream+gene+downstream into one file (requires include_gene)

    // Step-specific execution (null = full pipeline)
    step               = null
    blast              = false
    filter             = false
    orf                = false
    visual             = false
    neighbour          = false

    // Help
    help               = false
}

process {
    beforeScript = 'export PATH=/home/xinruoz/miniconda3/envs/allele_search/bin:$PATH'

    withName: 'BLAST_SEARCH' {
        cpus   = 2
        memory = '500 MB'
    }
    withName: 'MAFFT_ALIGN' {
        cpus   = 2
        memory = '4 GB'
    }
}

timeline {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/timeline.html"
}

report {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/report.html"
}
