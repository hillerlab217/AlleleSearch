params {
    // Input directories
    query_dir       = "${projectDir}/../surface_chaperones/data/query_sequences"
    genome_dir      = "${projectDir}/../surface_chaperones/data/genome_sequence"
    genome_ref_dir  = "${projectDir}/../surface_chaperones/data/GoldenSet_7548Genomes_2023"
    code_dir        = "${projectDir}/../surface_chaperones/code"

    // Output
    outdir          = "${projectDir}/results"

    // BLAST parameters
    blast_type      = 'blastn'
    make_blastdb    = false

    // Filtering cutoffs
    max_evalue         = 0.00001
    similarity         = 80
    length_percentage  = 80

    // ORF extension
    extension_codons   = 10

    // BLAST batching
    blast_batch_size   = 100

    // Allele filtering
    species_threshold  = 1

    // Optional steps
    skip_tcoffee       = false

    // Step control: 'all', 'blast_only', 'filter', 'post_filter', 'visualization'
    step               = 'all'
    blast_raw_dir      = null
    blast_filtered_dir = null
    aligned_seq_dir    = null

    // Help
    help               = false
}

process {
    conda = "${projectDir}/../surface_chaperones/environment.yml"

    withName: 'BLAST_SEARCH' {
        cpus   = 4
        memory = '4 GB'
    }
    withName: 'MAKE_BLAST_DB' {
        memory = '4 GB'
    }
    withName: 'MAFFT_ALIGN' {
        cpus   = 2
        memory = '4 GB'
    }
    withName: 'TCOFFEE_ALIGN' {
        cpus   = 2
        memory = '4 GB'
    }
}

conda.enabled = true

timeline {
    enabled = true
    file    = "${params.outdir}/timeline.html"
}

report {
    enabled = true
    file    = "${params.outdir}/report.html"
}
