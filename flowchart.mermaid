flowchart LR
    A[Query Sequences + Genomes] --> B[BLAST Search]
    subgraph "BLAST Search"
    B --> B1[Parse & Filter Hits]
    end
    
    B1 --> C[Check Start/Stop Codons]
    subgraph "ORF Identification"
    C --> C2{Incomplete?}
    C2 -- Yes --> C3[Extend Sequences]
    C2 -- No --> D
    C3 --> D[Translation]
    end
    
    subgraph "Translation"
    D --> D1[Translate All 3 Reading Frames]
    D1 --> D2[Keep Longest ORF]
    end
    
    D2 --> E[Allele Alignment]
    subgraph "Variant Analysis"
    E --> E1[Group Identical Proteins & identify variation position]
    end
    
    
    E1 --> F[Visualization]
    subgraph "Final Outputs"
    F --> F1["/logo"]
    F --> F2["/t-coffee"]
    F --> F3["/sequence_alignment"]
    E1 --> E2["/allele_info"]
    end

    style A fill:#f9f,stroke:#333,stroke-width:2px
    style F1 fill:#bbf,stroke:#333
    style F2 fill:#bbf,stroke:#333
    style F3 fill:#bbf,stroke:#333
    style E2 fill:#bbf,stroke:#333